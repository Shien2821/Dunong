rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['name', 'points', 'updatedAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.points is int && data.points >= 0 &&
             data.updatedAt == request.time &&
             (!('streak' in data) || data.streak is int) &&
             (!('avatar' in data) || (data.avatar == null || (data.avatar is string && data.avatar.size() <= 500000))) &&
             (!('completedLessons' in data) || data.completedLessons is list);
    }

    match /users/{userId} {
      // Leaderboard requires reading all users
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      
      // Users can only create/update their own profile
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && 
                      isValidUser(request.resource.data) &&
                      request.resource.data.points >= resource.data.points; // Points can only go up
      
      // Deletion is not allowed by users for now
      allow delete: if false;
    }
  }
}
